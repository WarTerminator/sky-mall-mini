<navigation-bar class="nav-bar" title="" back="{{false}}" height="{{navBarOpacity ? 'auto' : '0px'}}" background="rgba(255,255,255,{{navBarOpacity}})">
  <view class="nav-left" slot="center">
    <view class="nav-title" style='opacity: {{navBarOpacity}}'>
      MoN小卡世家
    </view>
  </view>
</navigation-bar>
<scroll-view
  class="scroll-area"
  type="custom"
  enhanced="{{true}}"
  upper-threshold="{{0}}"
  lower-threshold="{{400}}"
  scroll-y
  show-scrollbar="{{false}}"
  bindscrolltoupper="handleScrollToTop"
  bindscroll="handleScroll"
  bindscrolltolower="handleScrollEnd"
  scroll-into-view="{{intoViewY}}"
  using-sticky
>
  <view class="banners">
    <swiper
      autoplay="{{true}}"
      indicator-dots="{{banners.length > 1}}"
      indicator-color="rgba(65, 156, 241, .6)"
      indicator-active-color="#419CF1"
      class="banners-swiper"
      interval="2000"
      circular="{{true}}"
    >
      <swiper-item
        class="banners-swiper-item"
        wx:for="{{banners}}"
        wx:key="index"
        data-item="{{item}}"
        bindtap="handleHot"
      >
        <image mode="scaleToFill" src="{{item.img}}" class='banner-img'/>
      </swiper-item>
    </swiper>
  </view>

    <!-- 类目 -->
  <view
    class="category-wrp-content {{fixTab && 'fix-tab'}}"
    id="categoryWrap"
    style="top: {{navBar.navBarHeight - 1}}px">
    <swiper class="category-wrp">
      <block wx:for="{{categorySet}}" wx:key="page">
        <swiper-item>
          <view class="category-list">
            <block wx:for="{{item.categorys}}" wx:key="id" wx:for-item="category">
              <view class="category-item {{categoriesId === category.id && 'active'}}" data-item="{{category}}" bindtap="handleCategory">
                <image src="{{category.img}}" class="img-icon" />
                <view class="category-name">
                  <text>{{category.name}}</text>
                </view>
              </view>
            </block>
          </view>
        </swiper-item>
      </block>
    </swiper>
  </view>
  <!-- feeds流 -->
  <view wx:if="{{!goods.length}}" class="empty-wrap">
    <image src="https://img.war6sky.com/2024/09/ea102f999a944f989f5c7035e11544b9.png" />
    <text>空空如也～</text>
  </view>
  <grid-view
    padding="{{[6, 6, 6, 6]}}"
    cross-axis-gap="6"
    main-axis-gap="10"
    cross-axis-count="2"
    type="masonry"
  >
    <block wx:for="{{goods}}" wx:key="index">
      <goods-card item="{{item}}"></goods-card>
    </block>
  </grid-view>
  <view class="tabBarBlock"></view>
</scroll-view>
